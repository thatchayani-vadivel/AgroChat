# AgroChat Backend Environment Configuration Template
# Copy this file to .env and fill in your local credentials.
# Never commit .env to version control.

APP_NAME="AgroChat API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true

# Server Settings
API_HOST="127.0.0.1"
API_PORT=8000

# CORS Settings (comma-separated origins, or * for local development)
CORS_ORIGINS="http://localhost,http://127.0.0.1,*"

# MySQL Database Settings
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="agrochat_db"

# Security Settings (use a long random string in production)
SECRET_KEY="replace_with_a_secure_random_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

